<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>knobbrain</name>
  <version>0.1.0</version>
  <description>Closed-loop knob turning: reads the panel with a camera and
    drives the existing xarmrob stack through its three command topics.</description>
  <maintainer email="me439@example.com">me439</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>example_interfaces</exec_depend>
  <exec_depend>xarmrob</exec_depend>
  <exec_depend>xarmrob_interfaces</exec_depend>
  <exec_depend>mobrob</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
